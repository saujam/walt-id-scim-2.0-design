flowchart LR
  subgraph v1b["v1 — stable key binding"]
    direction TB
    U1["SCIM User"]:::ext --- K1["One holder DID / key"]:::bad
    K1 -.- N1["Goes stale with per-credential<br/>and batch keys, and becomes<br/>a correlation handle"]:::bad
  end
  v1b ==>|"v2"| v2b
  subgraph v2b["v2 — bind to issued credential instances (x509 issuers)"]
    direction TB
    U2["SCIM User"]:::ext
    I1["SD-JWT VC · batch A<br/>status index 18233"]:::lib
    I2["SD-JWT VC · batch A<br/>status index 90412"]:::lib
    I3["mdoc<br/>status index 4410"]:::lib
    SL1[("Token Status List<br/>JWT, x5c-signed")]:::walt
    SL2[("Token Status List<br/>CWT, x5c-signed")]:::walt
    U2 --> I1
    U2 --> I2
    U2 --> I3
    I1 --> SL1
    I2 --> SL1
    I3 --> SL2
  end

classDef lib fill:#EEF3FC,stroke:#3B6FD8,stroke-width:1.5px,color:#1B2533;
classDef walt fill:#E9F6EE,stroke:#2E9B5F,stroke-width:1.5px,color:#1B2533;
classDef ext fill:#F4F6F8,stroke:#8796A8,stroke-width:1.2px,color:#1B2533;
classDef opt fill:#FFFFFF,stroke:#8796A8,stroke-width:1.2px,stroke-dasharray:5 4,color:#4A5868;
classDef bad fill:#FDEDEC,stroke:#C0392B,stroke-width:1.5px,color:#1B2533;
classDef good fill:#E9F6EE,stroke:#2E9B5F,stroke-width:1.5px,color:#1B2533;

