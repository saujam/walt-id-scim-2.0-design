flowchart LR
  J["Incoming JSON<br/>any casing · URN extensions<br/>unknown attributes"]:::ext --> N["Key normalisation<br/>known → canonical spelling<br/>unknown → kept verbatim"]:::lib
  N --> D["<b>ScimDocument</b><br/>immutable JSON tree<br/>case-insensitive lookup"]:::lib
