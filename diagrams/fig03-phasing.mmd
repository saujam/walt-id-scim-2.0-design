flowchart LR
  subgraph P1["Phase 1 — generic library, four PRs"]
    direction LR
    PR1["<b>PR 1 · User core</b><br/>store SPI · context · isolation<br/>discovery · contract test kit<br/><i>Saurabh</i>"]:::lib
    PR2["<b>PR 2 · Routes</b><br/>Ktor · auth · wire format<br/>Entra validator, user tests<br/><i>walt.id</i>"]:::walt
    PR3["<b>PR 3 · PATCH + Groups</b><br/>membership rules · concurrency<br/>events · enforcement order<br/><i>Saurabh + walt.id</i>"]:::lib
    PR4["<b>PR 4 · Vendor quirks</b><br/>lenient / strict modes<br/>fixture corpus<br/><i>Saurabh</i>"]:::lib
  end
  subgraph P2["Phase 2 — proven on a real host"]
